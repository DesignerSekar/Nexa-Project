{
  "name": "@nexa/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @nexa/nexa-portal dev",
    "dev:mobile": "pnpm --filter @nexa/nexa-mobile start",
    "android": "pnpm --filter @nexa/nexa-mobile android",
    "build": "pnpm --filter @nexa/nexa-portal build",
    "preview": "pnpm --filter @nexa/nexa-portal preview",
    "typecheck": "tsc --noEmit -p apps/nexa-portal/tsconfig.json",
    "typecheck:mobile": "pnpm --filter @nexa/nexa-mobile typecheck",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "lint": "nx show projects && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:core": "vitest run --project core",
    "test:web": "vitest run --project web",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 -c libs/web/ui/.storybook",
    "build-storybook": "storybook build -c libs/web/ui/.storybook",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-router": "^1.161.4",
    "ag-grid-community": "^35.3.1",
    "ag-grid-enterprise": "^35.3.1",
    "ag-grid-react": "^35.3.1",
    "antd": "^6.1.4",
    "axios": "^1.13.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.48.0",
    "luxon": "^3.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.70.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.20.0",
    "@nx/eslint-plugin": "22.3.3",
    "@playwright/test": "^1.50.1",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.5.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-router-devtools": "^1.161.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.3",
    "msw": "^2.7.0",
    "nx": "22.3.3",
    "prettier": "^3.4.2",
    "storybook": "^8.5.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.3.5",
    "vitest": "^3.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "apps/nexa-portal/public"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "nx"
    ]
  }
}
