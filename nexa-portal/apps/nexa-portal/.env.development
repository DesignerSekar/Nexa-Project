# Loaded automatically by `vite` (dev mode). This is the default dev experience: talk to the real
# sidecar. Run `vite --mode mock` to use MSW instead.
#
# Empty so requests stay relative and go through the dev proxy, which makes the browser treat them
# as same-origin. That matters: the session is an HttpOnly cookie, and a cross-origin base URL
# would drag CORS and SameSite into a problem the proxy avoids entirely.
VITE_API_URL=

VITE_API_MODE=real

VITE_APP_TITLE=Nexa

# Where the dev proxy forwards /api and /health. Not a VITE_ variable on purpose — it is read by
# vite.config.ts at startup and never reaches the browser bundle.
#
# 8080 matches docker-compose. Change it to 8000 if you are running the sidecar directly with
# `python sidecar/main.py`, which calls uvicorn with port=8000.
NEXA_SIDECAR_URL=http://localhost:8080
