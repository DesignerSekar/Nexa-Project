# Copy to .env.local to override the committed defaults. .env.local is gitignored.
#
# The committed files already cover the normal cases, so you usually need none of this:
#   .env.development  loaded by `vite`                -> real sidecar via the dev proxy
#   .env.mock         loaded by `vite --mode mock`    -> MSW, no sidecar
#   .env.production   loaded by `vite build`          -> real sidecar via nginx

# Empty means same-origin. In dev that routes through the Vite proxy; in production nginx proxies
# /api on the same origin. Setting an absolute URL opts into CORS and will break the session
# cookie unless the sidecar's ALLOWED_ORIGINS is updated to match.
VITE_API_URL=

# mock -> MSW intercepts every request, no sidecar needed
# real -> talk to the sidecar
VITE_API_MODE=real

VITE_APP_TITLE=Nexa

# Dev-proxy target. Read by vite.config.ts, never sent to the browser.
# 8080 under docker-compose; 8000 when running `python sidecar/main.py` directly.
NEXA_SIDECAR_URL=http://localhost:8080
