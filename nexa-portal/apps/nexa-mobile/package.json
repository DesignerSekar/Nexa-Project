{
  "name": "@nexa/nexa-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "postinstall": "node ./scripts/patch-metro-fallback-watcher.js",
    "start": "node ./scripts/patch-metro-fallback-watcher.js && expo start --offline",
    "start:online": "node ./scripts/patch-metro-fallback-watcher.js && expo start",
    "android": "node ./scripts/run-android.js",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@nexa/auth": "workspace:*",
    "@nexa/contract": "workspace:*",
    "@nexa/data": "workspace:*",
    "@nexa/schemas": "workspace:*",
    "@nexa/tokens": "workspace:*",
    "@nexa/util": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@tanstack/query-core": "5.104.0",
    "@tanstack/react-query": "^5.90.19",
    "@expo/vector-icons": "^15.0.2",
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.33",
    "expo-modules-core": "~3.0.30",
    "expo-status-bar": "~3.0.9",
    "metro-runtime": "0.83.3",
    "pretty-format": "^29.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-paper": "^5.14.5",
    "react-native-web": "~0.21.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "react-refresh": "^0.14.2",
    "typescript": "~5.9.2",
    "vitest": "^3.0.5"
  },
  "nx": {
    "tags": ["scope:mobile", "type:app"]
  }
}
