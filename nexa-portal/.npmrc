# Enable hoisted node_modules linker to prevent Windows MAX_PATH (260 char) errors in NDK/CMake/Ninja builds
node-linker=hoisted

# Metro cannot resolve packages nested under pnpm's isolated store.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*expo-*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*metro-*
public-hoist-pattern[]=@tanstack/*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*react-native-*
public-hoist-pattern[]=pretty-format
public-hoist-pattern[]=react-refresh
public-hoist-pattern[]=*react-refresh*
